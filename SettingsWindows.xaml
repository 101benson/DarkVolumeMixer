<Window x:Class="DarkVolumeMixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Height="400" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="app.ico">

    <Window.Resources>
        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Background="Transparent" entfernt, damit Mausklicks zuverlässig ankommen -->
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" Background="#161619" BorderBrush="#383840" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                                <Path x:Name="CheckMark" Data="M3,9 L7,13 L15,4" Stroke="#FF9500" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9500"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#222226"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Horizontal Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Border Height="4" Background="#1B1B1E" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2A2A2E" BorderBrush="#FF9500" BorderThickness="1.5" CornerRadius="8">
                                                    <Ellipse Fill="#FF9500" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0E0E10" BorderBrush="#28282E" BorderThickness="1" CornerRadius="10" Padding="18" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                          Fill="#FF9500" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="EINSTELLUNGEN" FontSize="11" FontWeight="Bold" Foreground="#88888C" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Inhalte / Optionen -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Always on Top -->
                <Border Background="#161619" BorderBrush="#252529" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" 
                              Content="Immer im Vordergrund (Always on Top)" 
                              Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"
                              Cursor="Hand"/>
                </Border>

                <!-- Proportionale Master-Regelung -->
                <Border Background="#161619" BorderBrush="#252529" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <CheckBox x:Name="ProportionalMasterCheckBox" 
                            Content="Kanäle prozentual mit Master regeln" 
                            Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Border>

                <!-- Auto Adjust Width -->
                <Border Background="#161619" BorderBrush="#252529" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <CheckBox x:Name="AutoAdjustWidthCheckBox" 
                              Content="Breite automatisch an Inhalt anpassen" 
                              Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"
                              Cursor="Hand"/>
                </Border>

                <!-- Discord Limiter -->
                <Border Background="#161619" BorderBrush="#252529" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <CheckBox x:Name="DiscordLimiterCheckBox" 
                              Content="Discord Limiter aktivieren" 
                              Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"
                              Cursor="Hand"/>
                </Border>

                <!-- Discord Slider -->
                <Border Background="#161619" BorderBrush="#252529" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Discord Lautstärke-Zielwert:" Foreground="#88888C" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Value, ElementName=DiscordVolumeSlider, StringFormat={}{0:0}%}" 
                                       Foreground="#FF9500" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="DiscordVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Abbrechen" Click="CancelButton_Click" Width="95" Height="28" Margin="0,0,8,0" 
                        Background="#222226" Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A2A2E"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Speichern" Click="SaveButton_Click" Width="95" Height="28" 
                        Background="#FF9500" Foreground="#161619" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFAB33"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>