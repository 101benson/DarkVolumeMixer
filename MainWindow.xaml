<Window x:Class="DarkVolumeMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarkVolumeMixer"
        Title="{Binding SelectedDevice.FriendlyName, StringFormat='Dark Volume Mixer — {0}'}" 
        Height="Auto" MinHeight="380" MinWidth="380" MaxWidth="1920"
        Background="Transparent" Foreground="#D0D0D0"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="True" Topmost="{Binding IsAlwaysOnTop}"
        SizeToContent="Manual" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Icon="app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="6" 
                      CornerRadius="10" 
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88888C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fader-Style für App-Kacheln UND Master. Akzentfarbe kommt aus "Foreground", Thumb-Rand aus "BorderBrush".
             Klick auf die Schiene setzt den Regler direkt dorthin (siehe FaderSlider.cs). -->
        <Style x:Key="FaderStyle" TargetType="local:FaderSlider">
            <Setter Property="Foreground" Value="#00D294"/>
            <Setter Property="BorderBrush" Value="#44444C"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:FaderSlider">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Border Background="Transparent" Width="22" HorizontalAlignment="Center"/>
                            <Border Width="4" Background="#1B1B1E" CornerRadius="2" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Width="4" CornerRadius="2" HorizontalAlignment="Center" Opacity="0.55"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:FaderSlider}}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="14" Cursor="Hand"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           Foreground="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#2A2A2E" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1" CornerRadius="3">
                                                    <Rectangle Fill="{TemplateBinding Foreground}" Height="2" Width="12" 
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#34343A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3E3E46"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterFaderStyle" TargetType="local:FaderSlider" BasedOn="{StaticResource FaderStyle}">
            <Setter Property="Foreground" Value="#FF9500"/>
            <Setter Property="BorderBrush" Value="#FF9500"/>
        </Style>

        <!-- Mute-Button für App-Kacheln UND Master. Symbolfarbe kommt aus "Foreground". -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#00D294"/>
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,4">
                            <Path x:Name="MuteIcon" 
                                  Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z" 
                                  Fill="{TemplateBinding Foreground}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#3D1414"/>
                                <Setter TargetName="MuteIcon" Property="Data" Value="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 L19,14.5 L20.5,13 L18,10.5 L20.5,8 L19,6.5 L16.5,9 L14,6.5 L12.5,8 L15,10.5 L12.5,13 L14,14.5 Z"/>
                                <Setter TargetName="MuteIcon" Property="Fill" Value="#FF4D4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterMuteButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource MuteButtonStyle}">
            <Setter Property="Foreground" Value="#FF9500"/>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#161619"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderBrush" Value="#28282E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="#161619" BorderBrush="#28282E" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#88888C" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1E22"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#383840"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#FF9500"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,4,22,4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="#161619" BorderBrush="#383840" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#D0D0D0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2E"/>
                                            <Setter Property="Foreground" Value="#FF9500"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#222226"/>
                                            <Setter Property="Foreground" Value="#FF9500"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CardTemplate">
                                <Border Width="106" Background="#161619" BorderThickness="1" 
                                        CornerRadius="6" Margin="0,0,6,0" Padding="8" 
                                        VerticalAlignment="Stretch"
                                        PreviewMouseWheel="AppSlider_PreviewMouseWheel"
                                        MouseLeftButtonDown="AppCard_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="AppCard_PreviewMouseLeftButtonUp"
                                        MouseMove="AppCard_MouseMove"
                                        Drop="AppCard_Drop"
                                        AllowDrop="True">
                                    
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#252529"/>
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00D294"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Border Grid.Row="0" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6" Cursor="Hand" ToolTip="Klicken zum Anheften als Favorit">
                                            <Image Source="{Binding Icon, Mode=OneWay}" Width="20" Height="20" 
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   MouseLeftButtonUp="AppIcon_MouseLeftButtonUp"/>                                                   
                                        </Border>                                    

                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#BBBBBB" 
                                                   FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                   HorizontalAlignment="Center" MaxWidth="86"/>

                                        <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" 
                                                   Foreground="#888888" FontSize="12" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,8"/>

                                        <Grid Grid.Row="3" Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <local:FaderSlider Grid.Column="0" Style="{StaticResource FaderStyle}" 
                                                               Orientation="Vertical" Minimum="0" Maximum="100" 
                                                               Value="{Binding Volume, Mode=TwoWay}"
                                                               IsEnabled="{Binding IsEnabled}"
                                                               HorizontalAlignment="Center"/>

                                            <local:PeakMeter Grid.Column="1" Width="8" Margin="4,7,0,7"
                                                             Value="{Binding Peak}"/>
                                        </Grid>

                                        <ToggleButton Grid.Row="4" Style="{StaticResource MuteButtonStyle}"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      Margin="0,10,0,0" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

        <!-- ===== Listenansicht: horizontale Fader ===== -->
        <Style x:Key="HFaderStyle" TargetType="local:FaderSlider">
            <Setter Property="Foreground" Value="#00D294"/>
            <Setter Property="BorderBrush" Value="#44444C"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:FaderSlider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" Background="#1B1B1E" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Opacity="0.55"
                                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:FaderSlider}}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="20" Cursor="Hand"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           Foreground="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#2A2A2E" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="3">
                                                    <Rectangle Fill="{TemplateBinding Foreground}" Width="2" Height="10"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#34343A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3E3E46"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MasterHFaderStyle" TargetType="local:FaderSlider" BasedOn="{StaticResource HFaderStyle}">
            <Setter Property="Foreground" Value="#FF9500"/>
            <Setter Property="BorderBrush" Value="#FF9500"/>
        </Style>

        <!-- Kompakte Zeile: Icon links, Name, Fader + Pegel, Prozent, Mute -->
        <DataTemplate x:Key="RowTemplate">
            <Border Background="#161619" BorderThickness="1" CornerRadius="6" Margin="0,0,0,5" Padding="8,6"
                    PreviewMouseWheel="AppSlider_PreviewMouseWheel"
                    MouseLeftButtonDown="AppCard_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="AppCard_PreviewMouseLeftButtonUp"
                    MouseMove="AppCard_MouseMove"
                    Drop="AppCard_Drop"
                    AllowDrop="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#252529"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="BorderBrush" Value="#00D294"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip="Klicken zum Anheften als Favorit">
                        <Image Source="{Binding Icon, Mode=OneWay}" Width="20" Height="20" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonUp="AppIcon_MouseLeftButtonUp"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#BBBBBB"
                               FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:FaderSlider Grid.Row="0" Style="{StaticResource HFaderStyle}"
                                           Orientation="Horizontal" Minimum="0" Maximum="100"
                                           Value="{Binding Volume, Mode=TwoWay}"
                                           IsEnabled="{Binding IsEnabled}"/>
                        <local:PeakMeter Grid.Row="1" Orientation="Horizontal" Height="5" Margin="7,2,7,0"
                                         Value="{Binding Peak}"/>
                    </Grid>

                    <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="#888888" FontSize="12"
                               FontWeight="Bold" TextAlignment="Right" Width="38" VerticalAlignment="Center" Margin="6,0,6,0"/>

                    <ToggleButton Grid.Column="4" Style="{StaticResource MuteButtonStyle}" Width="34"
                                  IsChecked="{Binding IsMuted, Mode=TwoWay}" Cursor="Hand" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Border Background="#0E0E10" BorderBrush="#28282E" BorderThickness="1" CornerRadius="10" Padding="10,8,10,10"
            MouseDown="Window_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z" 
                          Fill="#FF9500" Width="16" Height="16" Stretch="Uniform" Margin="2,0,8,0" VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1" Text="DARK VOLUME MIXER - " FontSize="11" FontWeight="Bold" Foreground="#88888C" VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="2" Text="{Binding SelectedDevice.FriendlyName}" 
                               FontSize="11" FontWeight="Bold" Foreground="#FF9500" 
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Discord Limiter ToggleButton -->
                    <ToggleButton Width="28" Height="28" Margin="0,0,2,0" Cursor="Hand" ToolTip="Discord Limiter"
                                  IsChecked="{Binding IsDiscordLimiterActive, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" x:Name="border">
                                                <Path x:Name="IconPath" Data="M3,5 H21 V7 H3 Z M3,11 H15 V13 H3 Z M3,17 H21 V19 H3 Z M17,10 L21,12 L17,14 Z" 
                                                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#666666"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="IconPath" Property="Fill" Value="#FF9500"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>               
                    
                    <!-- Always on Top ToggleButton -->
                    <ToggleButton Width="28" Height="28" Margin="0,0,2,0" Cursor="Hand" ToolTip="Always on Top"
                                  IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" x:Name="border">
                                                <Path x:Name="IconPath" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" 
                                                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#666666"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="IconPath" Property="Fill" Value="#FF9500"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Listenansicht ToggleButton -->
                    <ToggleButton Width="28" Height="28" Margin="0,0,2,0" Cursor="Hand" ToolTip="Kompakte Listenansicht"
                                  IsChecked="{Binding IsListLayout, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" x:Name="border">
                                                <Path x:Name="IconPath" Data="M3,5 H21 V8 H3 Z M3,10.5 H21 V13.5 H3 Z M3,16 H21 V19 H3 Z"
                                                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#666666"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="IconPath" Property="Fill" Value="#FF9500"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A2A2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Button Click="SettingsButton_Click" Style="{StaticResource WindowControlButtonStyle}" 
                            Width="28" Height="28" Margin="0,0,2,0" Cursor="Hand" ToolTip="Einstellungen">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.67 9.13,18.92L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.92C15.48,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                              Width="14" Height="14" Stretch="Uniform" 
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" 
                            Width="28" Height="28" Margin="0,0,2,0" Cursor="Hand" ToolTip="In den Tray minimieren">
                        <Path Data="M4,11V13H20V11H4Z" 
                              Width="12" Height="12" Stretch="Uniform" 
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}" 
                            Width="28" Height="28" Cursor="Hand" ToolTip="Schließen">
                        <Path Data="M13.46,12L19,17.54V19H17.54L12,13.46L6.46,19H5V17.54L10.54,12L5,6.46V5H6.46L12,10.54L17.54,5H19V6.46L13.46,12Z" 
                              Width="10" Height="10" Stretch="Uniform" 
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Fader Grid -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Master Regler (Links) -->
                <Border Grid.Column="0" Grid.RowSpan="2" Background="#161619" BorderBrush="#FF9500" BorderThickness="1" 
                        CornerRadius="6" Margin="0,0,12,0" Padding="12" Width="110" 
                        VerticalAlignment="Stretch"
                        PreviewMouseWheel="MasterSlider_PreviewMouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Path Grid.Row="0" Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z" 
                              Fill="#FF9500" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Text="MASTER" FontWeight="Bold" Foreground="#FF9500" FontSize="11" TextAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="{Binding MasterVolume, StringFormat={}{0:0}%}" 
                                   Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,6"/>

                        <ComboBox Grid.Row="3" 
                               Style="{StaticResource DarkComboBoxStyle}"
                               ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                               SelectedItem="{Binding SelectedDevice, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                               DisplayMemberPath="FriendlyName"
                               Height="22" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

                        <Grid Grid.Row="4" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <local:FaderSlider Grid.Column="0" Style="{StaticResource MasterFaderStyle}" 
                                               Orientation="Vertical" Minimum="0" Maximum="100" 
                                               Value="{Binding MasterVolume, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" 
                                               IsEnabled="{Binding IsMasterEnabled}"
                                               HorizontalAlignment="Center"/>

                            <local:PeakMeter Grid.Column="1" Width="8" Margin="4,7,0,7"
                                             Value="{Binding MasterPeak, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>

                        <ToggleButton Grid.Row="5" Style="{StaticResource MasterMuteButtonStyle}"
                                      IsChecked="{Binding IsMasterMuted, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,8,0,0" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Master als Streifen (nur Listenansicht) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#161619" BorderBrush="#FF9500" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,8" Padding="8,6"
                        PreviewMouseWheel="MasterSlider_PreviewMouseWheel">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Row="0" Grid.ColumnSpan="5"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="FriendlyName"
                                  Height="22" Margin="0,0,0,6" VerticalContentAlignment="Center"/>

                        <Path Grid.Row="1" Grid.Column="0" Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z"
                              Fill="#FF9500" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" Text="MASTER" FontWeight="Bold" Foreground="#FF9500" FontSize="11"
                                   VerticalAlignment="Center"/>

                        <Grid Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <local:FaderSlider Grid.Row="0" Style="{StaticResource MasterHFaderStyle}"
                                               Orientation="Horizontal" Minimum="0" Maximum="100"
                                               Value="{Binding MasterVolume, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                               IsEnabled="{Binding IsMasterEnabled}"/>
                            <local:PeakMeter Grid.Row="1" Orientation="Horizontal" Height="5" Margin="7,2,7,0"
                                             Value="{Binding MasterPeak, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MasterVolume, StringFormat={}{0:0}%}" Foreground="#DDDDDD" FontSize="12"
                                   FontWeight="SemiBold" TextAlignment="Right" Width="38" VerticalAlignment="Center" Margin="6,0,6,0"/>

                        <ToggleButton Grid.Row="1" Grid.Column="4" Style="{StaticResource MasterMuteButtonStyle}" Width="34"
                                      IsChecked="{Binding IsMasterMuted, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- App-Kacheln (Mitte) -->
                <ScrollViewer x:Name="AppScrollViewer"
                            HorizontalScrollBarVisibility="Auto" 
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            CanContentScroll="False"
                            Padding="0,0,0,6">                           

                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Grid.RowSpan" Value="2"/>
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="#161619"/>
                            <Setter Property="Foreground" Value="#44444C"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="#161619">
                                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#3B3B42" CornerRadius="4"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>

                    <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sessions}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}"/>
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
